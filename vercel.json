{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install --prefix OBE",
  "buildCommand": "npm run --prefix OBE build",
  "outputDirectory": "OBE/dist",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/collections/urban", "destination": "/collections/urban/index.html" },
    { "source": "/collections/shore", "destination": "/collections/shore/index.html" },
    { "source": "/collections", "destination": "/collections/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
